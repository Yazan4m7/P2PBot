# Read-only phases 1-3. No Binance API key is required.
BINANCE_MGS_BASE=https://www.binance.com
DATABASE_URL=sqlite:///./data/p2pbot.sqlite3
DEFAULT_FIAT=JOD
DEFAULT_ASSET=USDT
SCAN_LIMIT=20
SCAN_INTERVAL_SECONDS=10
REQUEST_TIMEOUT_SECONDS=15

# Opportunity/risk filters for analysis only
MIN_COMPLETION_RATE=95
MIN_MERCHANT_ORDERS=20
MIN_NET_ROI_PCT=0.20
MAX_TRADE_FIAT=500
SLIPPAGE_BPS_PER_LEG=5
PLATFORM_FEE_BPS_PER_LEG=0
FIXED_BANK_FEE_BUY=0
FIXED_BANK_FEE_SELL=0

# Comma-separated exact Binance P2P payment-method identifiers. Blank = any.
PREFERRED_PAYMENT_METHODS=
